# Required — no defaults, app will not start without these
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_visa_agent
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_visa_agent_test
OPENAI_API_KEY=sk-...
JWT_SECRET=replace-with-32-char-random-string-min
JWT_REFRESH_SECRET=replace-with-different-32-char-random-string

# Optional — defaults shown
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3001
